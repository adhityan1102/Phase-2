{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/PHASE-II/",
  "name": "PHASE - II Revision Companion",
  "short_name": "PHASE - II",
  "description": "This is a Phase 2 study planner/calendar for students of Sri Chaitanya Techno School Trichy",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "tabbed"
  ],
  "orientation": "portrait",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://adhityan1102.github.io/PHASE-II/manifest.json"
    }
  ],
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://adhityan1102.github.io"
    }
  ],
  "widgets": [
    {
      "name": "Phase 2 Daily Focus",
      "short_name": "Phase 2",
      "description": "Quickly view today's Morning, Evening, and FAT revision sessions.",
      "tag": "phase2-focus",
      "ms_ac_template": "./widget-template.json",
      "data": "./widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "./icon.png",
          "sizes": "1600x1600",
          "label": "Phase 2 Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "./icon.png",
          "sizes": "1600x1600"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "./index.html?tab=3"
  },
  "protocol_handlers": [
    {
      "protocol": "web+phase2",
      "url": "./index.html?q=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "./icon.png",
      "sizes": "1600x1600",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon.png",
      "sizes": "1600x1600",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512' width='512' height='512'%3E%3Crect width='512' height='512' rx='115' fill='%23090d16'/%3E%3Ccircle cx='256' cy='256' r='168' fill='none' stroke='%2338bdf8' stroke-width='20'/%3E%3Ctext x='256' y='295' font-family='sans-serif' font-size='135' font-weight='800' fill='%23f8fafc' text-anchor='middle'%3EP2%3C/text%3E%3C/svg%3E",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192' width='192' height='192'%3E%3Crect width='192' height='192' rx='42' fill='%23090d16'/%3E%3Ccircle cx='96' cy='96' r='64' fill='none' stroke='%2338bdf8' stroke-width='8'/%3E%3Ctext x='96' y='112' font-family='sans-serif' font-size='52' font-weight='800' fill='%23f8fafc' text-anchor='middle'%3EP2%3C/text%3E%3C/svg%3E",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "./icon.png",
      "sizes": "1600x1600",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Phase 2 Daily Focus & Revision Tracker"
    },
    {
      "src": "./icon.png",
      "sizes": "1600x1600",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Phase 2 Full 66-Session Revision Companion"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's Focus",
      "short_name": "Focus",
      "description": "Open Morning, Evening, and FAT cards",
      "url": "./index.html?tab=0",
      "icons": [
        {
          "src": "./icon.png",
          "sizes": "1600x1600",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Full Schedule",
      "short_name": "Schedule",
      "description": "Browse all 66 sessions and FAT dates",
      "url": "./index.html?tab=1",
      "icons": [
        {
          "src": "./icon.png",
          "sizes": "1600x1600",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Timer & Error Vault",
      "short_name": "Vault",
      "description": "Practice timer and Dec 1-3 Error Rectification Vault",
      "url": "./index.html?tab=3",
      "icons": [
        {
          "src": "./icon.png",
          "sizes": "1600x1600",
          "type": "image/png"
        }
      ]
    }
  ]
}
